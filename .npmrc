# Fix Vercel deploy: npm ERESOLVE conflict.
# @hookform/resolvers v5 declares optional peer deps (@typeschema/valibot -> valibot ^0.39)
# that clash with its own valibot ^1.0.0 optional peer. This project uses zod, not valibot,
# so the conflict is purely between optional peers and safe to bypass.
legacy-peer-deps=true
