# Dipeshkyd — environment variables
#
# Local development: copy this file to `.env.local` and edit values.
# Vercel: Project → Settings → Environment Variables.
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined at BUILD time.
# Set them BEFORE the build runs; changing them later requires a rebuild/redeploy.
#
# Every variable has a safe default in lib/env.ts — the site builds and
# runs correctly even if none of these are set.

# Canonical site origin (no trailing slash) — used for SEO metadata
NEXT_PUBLIC_SITE_URL=https://dipeshkyd.com

# WhatsApp order number — wa.me format: country code + number, digits only
# (still used for shop orders and course enrollment chat)
NEXT_PUBLIC_WHATSAPP_NUMBER=9779821594372

# WhatsApp number as shown to visitors on the site
NEXT_PUBLIC_WHATSAPP_DISPLAY="+977 9821594372"

# Telegram handle without the @
NEXT_PUBLIC_TELEGRAM_HANDLE=deepeshkyd

# Business email — contact-form messages are delivered here
NEXT_PUBLIC_CONTACT_EMAIL=deepesh@dipeshkyd.com

# --- Contact form direct sending (Resend) ------------------------------
# Create a free API key at https://resend.com and set it here so the
# contact form sends email directly from the server. Without it, the form
# falls back to opening the visitor's email app with the message prefilled
# (still addressed to NEXT_PUBLIC_CONTACT_EMAIL).
RESEND_API_KEY=
# Optional: verified sender address, e.g. "Dipeshkyd Website <hello@dipeshkyd.com>"
# MAIL_FROM=

# No payment provider keys — checkout happens via WhatsApp/Telegram chat.

# --- Admin panel -------------------------------------------------------
# ADMIN_* variables are read at RUNTIME — changing them only needs an app
# restart, not a rebuild. Admin login stays fully disabled until
# ADMIN_PASSWORD is set (minimum 8 characters).
ADMIN_EMAIL=dipudon456@gmail.com
ADMIN_PASSWORD=
# Optional: cookie-signing secret (defaults to a value derived from ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=
