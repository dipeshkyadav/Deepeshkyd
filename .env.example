# ------------------------------------------------------------------
# Dipeshkyd — environment variables
# Local dev: copy this file to .env.local and fill in values.
# Vercel: Project → Settings → Environment Variables (then redeploy).
# ------------------------------------------------------------------

# ---- Admin panel (server-side, required for /admin) ----
# Login stays disabled until ADMIN_PASSWORD (8+ chars) is set.
ADMIN_EMAIL=dipudon456@gmail.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---- Email via Gmail SMTP (contact form, checkout verification, orders) ----
# SMTP_PASS is a Gmail App Password: Google Account → Security →
# 2-Step Verification → App passwords (NOT your normal Gmail password).
SMTP_USER=
SMTP_PASS=
# Optional overrides:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=Dipeshkyd Website <you@gmail.com>

# ---- Where orders & contact messages are delivered ----
BUSINESS_EMAIL=deepesh@dipeshkyd.com

# ---- Permanent photo uploads + admin content saves (Vercel Blob) ----
# Vercel dashboard → Storage → Create → Blob → connect to this project.
# Vercel adds this automatically; only set manually for local dev.
BLOB_READ_WRITE_TOKEN=

# ---- Optional fallback email provider (used only if SMTP is not set) ----
RESEND_API_KEY=

# ---- Public values (inlined at BUILD time — set before building) ----
NEXT_PUBLIC_SITE_URL=https://dipeshkyd.com
NEXT_PUBLIC_CONTACT_EMAIL=deepesh@dipeshkyd.com
NEXT_PUBLIC_WHATSAPP_NUMBER=9779821594372
NEXT_PUBLIC_WHATSAPP_DISPLAY=+977 9821594372
NEXT_PUBLIC_TELEGRAM_HANDLE=deepeshkyd
# Home hero photo — upload your cutout photo in /admin (photo uploader),
# paste the URL here, and redeploy:
# NEXT_PUBLIC_HERO_IMAGE=
